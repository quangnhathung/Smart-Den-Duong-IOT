  "components": {
    "schemas": {
      "AlertPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AlertResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "AlertPage"
      },
      "AlertResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "OPEN_LOAD",
              "OFFLINE"
            ],
            "title": "Kind"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "node_id",
          "kind",
          "started_at",
          "ended_at"
        ],
        "title": "AlertResponse"
      },
      "CommandInput": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "AUTO",
              "MANUAL"
            ],
            "title": "Mode"
          },
          "brightness": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Brightness"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "CommandInput"
      },
      "CommandResponse": {
        "properties": {
          "command_id": {
            "type": "string",
            "title": "Command Id"
          },
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "boot_id": {
            "type": "string",
            "title": "Boot Id"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "sent_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sent At"
          },
          "retry_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry At"
          },
          "result": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPLIED",
              "REJECTED",
              "TIMEOUT"
            ],
            "title": "Result"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "ack_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ack At"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          }
        },
        "type": "object",
        "required": [
          "command_id",
          "node_id",
          "boot_id",
          "payload",
          "created_at",
          "sent_at",
          "retry_at",
          "result",
          "reason",
          "ack_at",
          "attempts"
        ],
        "title": "CommandResponse"
      },
      "ExperimentInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "configuration": {
            "additionalProperties": true,
            "type": "object",
            "title": "Configuration"
          },
          "notes": {
            "type": "string",
            "maxLength": 4000,
            "title": "Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ExperimentInput"
      },
      "ExperimentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "configuration": {
            "additionalProperties": true,
            "type": "object",
            "title": "Configuration"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "configuration",
          "notes",
          "started_at",
          "ended_at"
        ],
        "title": "ExperimentResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "DEGRADED"
            ],
            "title": "Status"
          },
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "broker": {
            "type": "boolean",
            "title": "Broker"
          },
          "queue": {
            "type": "boolean",
            "title": "Queue"
          },
          "dropped_events": {
            "type": "integer",
            "title": "Dropped Events"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "broker",
          "queue",
          "dropped_events"
        ],
        "title": "HealthResponse"
      },
      "HistoryItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          },
          "quality": {
            "type": "string",
            "title": "Quality"
          },
          "telemetry": {
            "$ref": "#/components/schemas/HttpTelemetry"
          }
        },
        "type": "object",
        "required": [
          "id",
          "received_at",
          "quality",
          "telemetry"
        ],
        "title": "HistoryItem"
      },
      "HistoryPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/HistoryItem"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "HistoryPage"
      },
      "HttpTelemetry": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 1.0,
            "title": "Schema Version"
          },
          "node_id": {
            "type": "string",
            "enum": [
              "node_01",
              "node_02",
              "node_03"
            ],
            "title": "Node Id"
          },
          "boot_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}$",
            "title": "Boot Id"
          },
          "seq": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Seq"
          },
          "uptime_ms": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Uptime Ms"
          },
          "mode": {
            "type": "string",
            "enum": [
              "AUTO",
              "MANUAL"
            ],
            "title": "Mode"
          },
          "environment": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "DAY",
              "TWILIGHT",
              "NIGHT"
            ],
            "title": "Environment"
          },
          "ldr_adc": {
            "type": "integer",
            "maximum": 4095.0,
            "minimum": 0.0,
            "title": "Ldr Adc"
          },
          "motion": {
            "type": "string",
            "enum": [
              "NONE",
              "PEDESTRIAN",
              "VEHICLE",
              "UNKNOWN"
            ],
            "title": "Motion"
          },
          "distance_cm": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Cm"
          },
          "brightness_target": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Brightness Target"
          },
          "brightness_applied": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Brightness Applied"
          },
          "current_adc": {
            "type": "integer",
            "maximum": 4095.0,
            "minimum": 0.0,
            "title": "Current Adc"
          },
          "current_ma_sim": {
            "type": "number",
            "minimum": 0.0,
            "title": "Current Ma Sim"
          },
          "power_sim_w": {
            "type": "number",
            "minimum": 0.0,
            "title": "Power Sim W"
          },
          "faults": {
            "items": {
              "type": "string",
              "const": "OPEN_LOAD"
            },
            "type": "array",
            "title": "Faults"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "node_id",
          "boot_id",
          "seq",
          "uptime_ms",
          "mode",
          "environment",
          "ldr_adc",
          "motion",
          "distance_cm",
          "brightness_target",
          "brightness_applied",
          "current_adc",
          "current_ma_sim",
          "power_sim_w",
          "faults"
        ],
        "title": "HttpTelemetry"
      },
      "NodeResponse": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "connection": {
            "type": "string",
            "enum": [
              "ONLINE",
              "OFFLINE",
              "UNKNOWN"
