            "title": "Connection"
          },
          "freshness": {
            "type": "string",
            "enum": [
              "FRESH",
              "STALE"
            ],
            "title": "Freshness"
          },
          "last_seen": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen"
          },
          "age_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
