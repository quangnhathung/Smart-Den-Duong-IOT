 assert(posts===1,'MANUAL single POST and APPLIED only after backend result');
 await page.waitForFunction(()=>document.getElementById('detailReadings').textContent.includes('80%'));
 assert(true,'actual applied telemetry displayed separately from ACK');
 await page.locator('#brightnessNumber').fill('73');await page.locator('#brightnessNumber').dispatchEvent('input');
 await page.waitForTimeout(1200);
 assert(await page.locator('#brightnessNumber').inputValue()==='73','draft preserved through polling');
 await label();await page.screenshot({path:'output/playwright/node-desktop.png',fullPage:true});
 await page.getByRole('link',{name:'Lịch sử dữ liệu',exact:true}).click();
 await page.waitForFunction(()=>document.getElementById('historyMessage').textContent.includes('Đang xem'));
 assert(await page.locator('#brightnessChart svg').count()===1,'native SVG history chart');
 await page.locator('#sampleIndex').focus();await page.keyboard.press('ArrowRight');
 assert((await page.locator('#sampleValue').innerText()).includes('applied'),'keyboard data inspector');
 await label();await page.screenshot({path:'output/playwright/history-desktop.png',fullPage:true});
 await page.getByRole('link',{name:'Cảnh báo',exact:false}).first().click();
 await page.waitForFunction(()=>document.getElementById('alertRows').innerText.includes('node_02'));
 assert(true,'alerts read from API');
 await page.getByRole('link',{name:'Phiên thực nghiệm',exact:true}).click();
 await page.waitForFunction(()=>document.getElementById('experimentList').textContent.includes('EX-02'));
 await page.locator('[data-experiment]').first().click();
 await page.waitForFunction(()=>!document.getElementById('experimentDetail').hidden);
 assert(await page.locator('#stopExperiment').isDisabled(),'stopped experiment restored from server');
 const downloadPromise=page.waitForEvent('download');await page.getByRole('button',{name:'Tải CSV',exact:true}).click();const download=await downloadPromise;
 assert(download.suggestedFilename().endsWith('.csv'),'CSV download');
 await download.saveAs('output/playwright/experiment-fixture.csv');
 await page.locator('#experimentName').fill('QA · Kiểm thử giao diện');
 await page.locator('#experimentConfig').fill('{"source":"synthetic browser QA"}');
 await page.getByRole('button',{name:'Bắt đầu phiên đo',exact:true}).click();
 await page.waitForFunction(()=>document.getElementById('experimentDetailTitle').textContent.includes('QA ·'));
 assert(await page.locator('#startExperiment').isDisabled(),'single active experiment guarded');
 await page.reload();await page.waitForFunction(()=>document.getElementById('experimentMessage').textContent.includes('QA ·'));
 await page.getByRole('button',{name:'QA · Kiểm thử giao diện'}).click();
 await page.waitForFunction(()=>!document.getElementById('stopExperiment').disabled);
 await page.getByRole('button',{name:'Dừng phiên',exact:true}).click();
 await page.waitForFunction(()=>document.getElementById('experimentActionMessage').textContent.includes('Phiên đã dừng'));
 assert(true,'experiment start, reload restore, stop');
 for (const width of [375,768,1024,1440]){
   await page.setViewportSize({width,height:900});
   await page.getByRole('link',{name:'Tổng quan',exact:true}).click();
   await page.waitForTimeout(100);await label();
   const size=await page.evaluate(()=>({scroll:document.documentElement.scrollWidth,view:innerWidth}));
   assert(size.scroll<=size.view,`no document overflow ${width}px`);
   if(width===375)await page.screenshot({path:'output/playwright/overview-mobile.png',fullPage:true});
 }
 await page.emulateMedia({reducedMotion:'reduce'});
