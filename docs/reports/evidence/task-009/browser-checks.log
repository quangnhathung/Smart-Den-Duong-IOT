 await page.getByRole('link',{name:'Điều khiển node',exact:true}).click();
 await page.route('http://127.0.0.1:8000/api/**',route=>route.abort());
 await page.getByRole('button',{name:'Cập nhật',exact:true}).click();
 await page.waitForFunction(()=>document.getElementById('applyCommand').disabled);
 assert((await page.locator('#connectionNotice').innerText()).includes('khóa'),'API loss marks stale and locks actions');
 await page.unroute('http://127.0.0.1:8000/api/**');
 await page.waitForFunction(()=>document.getElementById('apiBadge').textContent==='Máy chủ sẵn sàng');
 assert(true,'API recovery without POST replay');
 page.off('request',record);
 return checks;
}
)(page);
